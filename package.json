{
  "name": "hush",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:line-limits && vite build",
    "check:line-limits": "bash scripts/check-line-limits.sh",
    "tauri": "tauri",
    "build:macos": "tauri build",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "ios:init": "tauri ios init",
    "build:ios": "tauri ios build --debug && ios-deploy --bundle src-tauri/gen/apple/build/arm64/Hush.ipa"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@fontsource/eb-garamond": "^5.2.7",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/karla": "^5.2.8",
    "@fontsource/libre-baskerville": "^5.2.10",
    "@fontsource/libre-franklin": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@fontsource/source-sans-pro": "^5.2.5",
    "@fontsource/source-serif-pro": "^5.2.5",
    "@lezer/markdown": "^1.6.3",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.8",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-positioner": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "codemirror": "^6.0.2",
    "esbuild": "^0.27.4",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^5.7.284",
    "thememirror": "^2.0.1",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "typescript": "~5.9.3"
  }
}
