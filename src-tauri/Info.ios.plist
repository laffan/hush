<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>LSApplicationQueriesSchemes</key>
  <array>
    <string>zotero</string>
    <string>obsidian</string>
  </array>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>hushwriter</string>
      </array>
      <key>CFBundleURLName</key>
      <string>com.hushwriter.app</string>
    </dict>
  </array>
  <!--
    iPad multi-window (UIScene). Enables a second window opened by the
    tauri-plugin-ipad-window bridge. We deliberately omit a
    UISceneConfigurations array: the plugin builds the file-window scene
    configuration in code (setting its delegateClass) from a swizzled
    application(_:configurationForConnecting:), so Tauri's own primary
    scene is left untouched and no Swift class needs naming here.
    See IPAD-MULTI-WINDOW-PLANNING.md. ⚠️ Verify on-device that enabling
    multiple scenes leaves Tauri's primary window intact.
  -->
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <true/>
  </dict>
  <key>NSUserActivityTypes</key>
  <array>
    <string>com.hushwriter.app.fileWindow</string>
  </array>
</dict>
</plist>
