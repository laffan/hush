{
  "$schema": "https://raw.githubusercontent.com/nickelpack/npe/main/tauri.conf.json",
  "productName": "Hush",
  "version": "0.1.0",
  "identifier": "com.hush.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hush",
        "width": 400,
        "height": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true,
      "tooltip": "Hush"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": []
    }
  },
  "plugins": {
    "fs": {
      "scope": {
        "allow": [
          { "path": "$APPDATA/**" },
          { "path": "$HOME/**" }
        ]
      }
    }
  }
}
