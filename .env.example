# Dropbox App Key for OAuth PKCE authentication
# Create a Dropbox app at https://www.dropbox.com/developers/apps
VITE_DROPBOX_APP_KEY=your_app_key_here

# Redirect URI — must exactly match one configured in your Dropbox app settings.
# For development: http://localhost:5173/oauth-callback.html
# For production: hushwriter://auth/callback
VITE_DROPBOX_REDIRECT_URI=http://localhost:5173/oauth-callback.html

# Google OAuth client id for the per-document Google Docs link feature
# (Phase 2 of the Google Docs integration). Create a "Desktop application"
# OAuth client at https://console.cloud.google.com/apis/credentials and
# enable both the Google Drive API and the Google Docs API on the project.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Redirect URI for Google. Register both the localhost URL (dev) and the
# custom-scheme URL (production) on the OAuth client.
# For development: http://localhost:5173/oauth-callback.html
# For production: hushwriter://auth/google/callback
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/oauth-callback.html
