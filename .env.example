# Dropbox App Key for OAuth PKCE authentication
# Create a Dropbox app at https://www.dropbox.com/developers/apps
VITE_DROPBOX_APP_KEY=your_app_key_here

# Redirect URI — must exactly match one configured in your Dropbox app settings.
# For development: http://localhost:5173/oauth-callback.html
# For production: hushwriter://auth/callback
VITE_DROPBOX_REDIRECT_URI=http://localhost:5173/oauth-callback.html

# Google Sync uses per-install OAuth credentials entered in
# Settings > Sync > Google Sync — no env vars required. The OAuth
# callback rides a one-shot loopback HTTP listener on 127.0.0.1, so the
# redirect URI registered on your Google OAuth client must be exactly
# http://127.0.0.1 (no port — Google wildcards loopback ports at runtime).
