{
  "name": "Typewriter Paper",
  "fontFamily": "iA Writer Mono",
  "fontSize": 18,
  "lineHeight": 1.7,
  "lightThemeId": "smoothy",
  "darkThemeId": "dracula",
  "lightColors": {
    "bg": "#f5efe1",
    "fg": "#2b2620",
